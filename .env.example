# ─────────────────────────────────────────────────────────────────────────────
# LuxeStay LA — environment variables
# Copy to .env.local for development. Never commit real values.
# NEXT_PUBLIC_* values are exposed to the browser and inlined at build time:
# never put secrets in them.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical site origin (no trailing slash). Used for canonical URLs, Open Graph,
# sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" ONLY on the production deployment to allow search indexing.
# Any other value (or unset) serves a robots.txt that disallows crawling.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Property data ────────────────────────────────────────────────────────────
# "sample" (default) uses clearly-labelled fictional listings.
# "rentcafe" uses the Yardi / RentCafe adapter (see docs/INTEGRATION.md).
PROPERTY_DATA_SOURCE=sample

# Server-only. Required once the RentCafe adapter is implemented.
# Exact names/fields depend on the integration method Yardi confirms.
RENTCAFE_API_BASE_URL=
RENTCAFE_API_TOKEN=
RENTCAFE_COMPANY_CODE=
RENTCAFE_PROPERTY_CODES=

# Official leasing / application portal (e.g. the client's RentCafe site).
# When set, it is offered wherever listings are unavailable and on the contact page.
NEXT_PUBLIC_LEASING_PORTAL_URL=

# ── Contact form delivery ────────────────────────────────────────────────────
# Server-only. Validated inquiries are POSTed as JSON to this endpoint
# (CRM, form service, email relay, or a verified RentCafe lead endpoint).
# Required in production: without it the form shows an error instead of
# pretending the message was sent.
CONTACT_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <secret>".
CONTACT_WEBHOOK_SECRET=

# ── Public contact details (leave blank until verified by the client) ───────
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_BUSINESS_HOURS=

# ── Resident Dashboard ───────────────────────────────────────────────────────
# Server-only. Signs resident session cookies. Required for sign-in.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Identity provider for resident sign-in: "fixtures" (development only) or
# "rentcafe" (not implemented until a verified method exists). Unset = sign-in off.
RESIDENT_AUTH_PROVIDER=

# Resident data source: "fixtures" (development only) or "rentcafe" (stub).
RESIDENT_DATA_SOURCE=

# Development fixture sign-in password (≥ 12 characters). Fixture residents:
# resident.a@example.test and resident.b@example.test (fictional).
DEV_RESIDENT_PASSWORD=

# DANGER: enables fixtures in a production build (password-protected staging only).
# Never set on the public production site.
ALLOW_RESIDENT_FIXTURES_IN_PRODUCTION=false

# Official RentCafe resident portal (payments, maintenance, documents fallback).
NEXT_PUBLIC_RESIDENT_PORTAL_URL=
